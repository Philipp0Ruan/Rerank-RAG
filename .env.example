# Copie para .env e preencha localmente. Nunca publique sua chave.
OPENAI_API_KEY=
# Pode ser trocado por um modelo disponível na sua conta.
OPENAI_MODEL=gpt-5-mini
# Opcional: deixe vazio para usar a configuração padrão do modelo.
# Nem todo modelo aceita temperatura personalizada.
OPENAI_TEMPERATURE=
